// Schema Prisma: define modelos, relacionamentos e índices do banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String          @id @default(cuid())
  nome      String
  email     String          @unique
  senha     String?
  avatar    String?
  cargo     String?
  cabos     CaboEleitoral[]
  lideres   Lider[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("User")
}

model CaboEleitoral {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  liderId   String?
  lider     Lider?    @relation(fields: [liderId], references: [id], onDelete: SetNull)
  nome      String
  titulo    String
  zona      String
  email     String    @unique
  telefone  String?
  avatar    String?
  eleitores Eleitor[]
  familias  Familia[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([adminId])
  @@index([liderId])
}

model Lider {
  id        String          @id @default(cuid())
  adminId   String
  admin     Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  nome      String
  email     String?         @unique
  telefone  String?
  cargo     String?
  avatar    String?
  cor       String?
  cabos     CaboEleitoral[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([adminId])
}

model Eleitor {
  id                String         @id @default(cuid())
  caboEleitoralId   String         @map("userId")
  caboEleitoral     CaboEleitoral  @relation(fields: [caboEleitoralId], references: [id], onDelete: Cascade)
  nome              String?
  cpf               String?        @unique
  tituloEleitor     String?        @unique
  telefone          String?
  sessao            String?
  zona              String?
  localVotacao      String?
  promessa          String?
  promessaConcluida Boolean        @default(false)
  familias          FamiliaMembro[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([caboEleitoralId])
  @@index([createdAt])
  @@index([zona])
  @@index([promessaConcluida])
}

model Familia {
  id              String          @id @default(cuid())
  caboEleitoralId String
  caboEleitoral   CaboEleitoral   @relation(fields: [caboEleitoralId], references: [id], onDelete: Cascade)
  nome            String?
  membros         FamiliaMembro[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([caboEleitoralId])
}

model FamiliaMembro {
  id              String   @id @default(cuid())
  familiaId       String
  familia         Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  eleitorId       String
  eleitor         Eleitor  @relation(fields: [eleitorId], references: [id], onDelete: Cascade)
  grauParentesco  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([familiaId, eleitorId])
  @@index([familiaId])
  @@index([eleitorId])
}

// Token temporário gerado para o fluxo de recuperação de senha.
// Expira em 30 minutos e só pode ser usado uma vez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  role      String    // 'admin' | 'cabo'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}
