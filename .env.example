# Configuração de Ambiente do Sistema SEL (Template de Exemplo)
# ATENÇÃO: NUNCA insira credenciais reais de produção neste arquivo.
# Copie este arquivo para .env.local ou .env e configure os valores específicos do seu ambiente.

# ── Banco de Dados (PostgreSQL / Prisma) ──
DATABASE_PROVIDER="postgres"
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sistema_sel?schema=public"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5432/sistema_sel?schema=public"

# Fallback para armazenamento em memória (permitido APENAS em ambiente de desenvolvimento)
DATABASE_FALLBACK_TO_MEMORY="false"

# ── Autenticação e Segurança (JWT) ──
# Gere uma chave segura aleatória de pelo menos 64 caracteres (ex: openssl rand -hex 64)
JWT_SECRET="gere_uma_chave_secreta_longa_e_aleatoria_com_openssl_rand_hex_64"

# URL pública da aplicação (utilizada para geração segura de links de recuperação)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Notificações por E-mail (SMTP / Resend) ──
RESEND_API_KEY=""
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="Sistema SEL <noreply@exemplo.com>"

# ── Políticas Opcionais de Rate Limiting ──
# RATE_LIMIT_LOGIN_MAX="5"
# RATE_LIMIT_LOGIN_WINDOW_MS="900000"
# RATE_LIMIT_RESET_PASSWORD_MAX="40"
# RATE_LIMIT_RESET_PASSWORD_WINDOW_MS="900000"
# RATE_LIMIT_CHANGE_PASSWORD_MAX="10"
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS="900000"
# RATE_LIMIT_ELEITOR_VALIDATE_MAX="60"
# RATE_LIMIT_ELEITOR_VALIDATE_WINDOW_MS="60000"
